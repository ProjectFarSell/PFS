# Reference only. Configure secrets in the chosen hosting service; never commit a filled copy.
APP_NAME=FarSell
APP_ENV=production
ADMIN_MFA_REQUIRED=true
SELLER_MFA_REQUIRED=true
LOGIN_OTP_REQUIRED=true
APP_DEBUG=false
APP_KEY=
APP_URL=https://CHANGE-ME.invalid
RELEASE_VERSION=REPLACE_WITH_GIT_SHA
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=REPLACE_WITH_PRIVATE_DATABASE_HOST
DB_PORT=3306
DB_DATABASE=farsell_production
DB_USERNAME=REPLACE_WITH_APP_DATABASE_USER
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=farsell_production_session
CACHE_STORE=database
QUEUE_CONNECTION=database
NOTIFICATION_QUEUE_CONNECTION=database
NOTIFICATION_QUEUE=notifications
NOTIFICATION_MAILER=smtp
ORDER_NOTIFICATIONS_ENABLED=true
MAIL_MAILER=smtp
MAIL_HOST=REPLACE_WITH_VERIFIED_MAIL_PROVIDER
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=REPLACE_WITH_VERIFIED_SENDER
MAIL_TIMEOUT=15
CHECKOUT_ENABLED=false
ALLOW_DEMO_PAYMENTS=false
BETA_ENABLED=true
BETA_CITY_IDS=
TRUSTED_PROXIES=
ALLOWED_HOSTS=
REQUIRE_OPERATIONAL_HEARTBEATS=true
HEARTBEAT_MAX_AGE=180
QUEUE_MAX_AGE=300
SLOW_REQUEST_MS=1000
BACKUP_PASSWORD=
BACKUP_MAX_AGE_HOURS=24
RUN_MIGRATIONS=false
# Provision Google/Firebase, invoice, and storage settings separately for this environment.
# Cloudflare DNS/proxy/WAF configuration is intentionally outside this change.

# Mobile providers are disabled until configured and verified on staging.
MOBILE_STAGING_PAYMENTS=false
MOBILE_PUSH_ENABLED=false
MOBILE_REALTIME_ENABLED=false
MOBILE_QUEUE=mobile
MOBILE_QUEUE_CONNECTION=database
MOBILE_FCM_PROJECT_ID=
MOBILE_FCM_CREDENTIALS=
MOBILE_PROOF_RETENTION_DAYS=0
MOBILE_ANDROID_PACKAGE=
MOBILE_ANDROID_SHA256=
MOBILE_IOS_APP_IDS=
MOBILE_SUPPORT_EMAIL=
MOBILE_STAGING_FIXTURES=false
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=
MOBILE_ALERT_EMAIL=

# Optional native Google audience; falls back to GOOGLE_CLIENT_ID
MOBILE_GOOGLE_CLIENT_ID=
MOBILE_FIREBASE_PROJECT_ID=
MOBILE_RIDER_FIREBASE_PROJECT_ID=
MOBILE_RIDER_FCM_PROJECT_ID=
MOBILE_RIDER_FCM_CREDENTIALS=
MOBILE_RIDER_ANDROID_PACKAGE=
MOBILE_RIDER_ANDROID_SHA256=
