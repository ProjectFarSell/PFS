APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
ADMIN_MFA_REQUIRED=true
SELLER_MFA_REQUIRED=true
LOGIN_OTP_REQUIRED=true

# Deployment settings are intentionally inactive on local development.
RELEASE_VERSION=development
TRUSTED_PROXIES=
ALLOWED_HOSTS=
HSTS_SECONDS=31536000
CHECKOUT_ENABLED=true
# Set false for staging/production; local gateway_stub orders are demonstrations only.
ALLOW_DEMO_PAYMENTS=true
BETA_ENABLED=false
BETA_CITY_IDS=
SLOW_REQUEST_MS=1000
REQUIRE_OPERATIONAL_HEARTBEATS=false
HEARTBEAT_MAX_AGE=180
QUEUE_MAX_AGE=300
BACKUP_MAX_AGE_HOURS=24
# Provide a unique secret of at least 20 characters before using ops:backup.
BACKUP_PASSWORD=

DELIVERY_FEE=49

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

INVOICE_GENERATOR_API_KEY=
INVOICE_GENERATOR_ENDPOINT=https://invoice-generator.com
INVOICE_GENERATOR_FROM="FarSell Marketplace"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

ORDER_NOTIFICATIONS_ENABLED=true
NOTIFICATION_QUEUE_CONNECTION=database
NOTIFICATION_QUEUE=notifications
# log writes test messages locally. Use mailpit for the local sandbox inbox.
NOTIFICATION_MAILER=log
MAILPIT_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_TIMEOUT=15
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Firebase Phone Auth configuration. These browser configuration values are not secrets.
# Enable Phone Authentication in Firebase Console, add localhost to Authorized domains,
# and use Firebase test phone numbers for local testing when possible.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# New-order fee snapshots. Basis points: 800 = 8%; monetary values are centavos.
MARKETPLACE_COMMISSION_BPS=800
MARKETPLACE_RIDER_PAY_CENTS=4000
MARKETPLACE_COD_COST_CENTS=700
MARKETPLACE_OPERATING_COST_CENTS=1500

# Courier booking API is optional. Manual Lalamove records work without keys.
LALAMOVE_ENABLED=false
LALAMOVE_ENVIRONMENT=sandbox
LALAMOVE_API_KEY=
LALAMOVE_API_SECRET=
LALAMOVE_ALLOW_LIVE_BOOKINGS=false

# Native mobile API and delivery providers (no secrets belong in Flutter)
MOBILE_STAGING_PAYMENTS=false
MOBILE_EVENTS_ENABLED=true
MOBILE_PUSH_ENABLED=false
MOBILE_REALTIME_ENABLED=false
MOBILE_QUEUE=mobile
MOBILE_QUEUE_CONNECTION=database
MOBILE_FCM_PROJECT_ID=
MOBILE_FCM_CREDENTIALS=
MOBILE_PROOF_RETENTION_DAYS=0
MOBILE_ANDROID_PACKAGE=
MOBILE_ANDROID_SHA256=
MOBILE_IOS_APP_IDS=
MOBILE_SUPPORT_EMAIL=
MOBILE_STAGING_FIXTURES=false
MOBILE_FIXTURE_PASSWORD=
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1
MOBILE_ALERT_EMAIL=

# Optional native Google audience; falls back to GOOGLE_CLIENT_ID
MOBILE_GOOGLE_CLIENT_ID=
MOBILE_FIREBASE_PROJECT_ID=
